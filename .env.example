# gfgf environment — copy to .env and adjust as needed:
#   cp .env.example .env
#
# Postgres credentials. If you change POSTGRES_USER/PASSWORD/DB, update
# DATABASE_URL below to match (the app only reads DATABASE_URL).
POSTGRES_USER=gfgf
POSTGRES_PASSWORD=gfgf
POSTGRES_DB=gfgf

# Async SQLAlchemy DSN used by the backend. Inside compose the host is `db`.
# Keep the postgresql+asyncpg:// scheme — the backend validates it.
DATABASE_URL=postgresql+asyncpg://gfgf:gfgf@db:5432/gfgf

# Host ports the backend and frontend are published on.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-facing API base URL. Optional — the frontend auto-detects the backend
# from the browser's own hostname on port 8000, so LAN access works out of the
# box. Set it only to point at a non-standard backend host/port:
#NEXT_PUBLIC_API_BASE_URL=http://<server-ip>:8000
